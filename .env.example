# === Docker Compose uchun asosiy sozlamalar ===
# Nusxalash: cp .env.example .env

# AI provayder: gemini (standart), vertex yoki claude
AI_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite
# Server uchun tavsiya: service-account fayli + Vertex AI
# AI_PROVIDER=vertex
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-credentials.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# VERTEX_GEMINI_MODEL=gemini-2.5-flash-lite
# ANTHROPIC_API_KEY=sk-ant-...

# Admin panel tokeni (kuchli tasodifiy qiymat qo'ying!)
ADMIN_TOKEN=bu-yerga-kuchli-tasodifiy-token-kiriting
# Ixtiyoriy: JWT uchun ADMIN_TOKEN'dan alohida 32+ belgili sir
# JWT_SECRET_KEY=bu-yerga-boshqa-kuchli-tasodifiy-sir-kiriting

# Telegram (bot va kanal uchun)
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHANNEL_ID=@biznesxabari

# PostgreSQL paroli
POSTGRES_PASSWORD=kuchli-parol
# Docker'siz PostgreSQL ishlatilsa ulanish satri
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/biznesxabar

# Avto-chop etish sozlamalari
AUTO_PUBLISH=true
AUTO_PUBLISH_MIN_IMPORTANCE=1
AUTO_TELEGRAM=true
AUTO_TELEGRAM_MIN_IMPORTANCE=4

# Pipeline necha soniyada bir ishlaydi (3600 = har soatda)
PIPELINE_INTERVAL=3600
LESSON_BATCH_PER_RUN=3
PIPELINE_STALE_MINUTES=120
# PIPELINE_ALERT_WEBHOOK_URL=https://monitor.example.com/hooks/...

# Production media storage (service-role kaliti faqat backend'da bo'lsin)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media
STORAGE_MAX_FILE_MB=6

# Kuratsiya katalogidan keyingi kunlik RSS g'oya pipeline'i
RSS_IDEA_ENABLED=true
RSS_IDEA_INTERVAL_DAYS=1
RSS_IDEA_SUGGESTIONS_PER_BATCH=8
RSS_FEED_ITEMS_PER_SOURCE=5

# Render'dagi yagona web service uchun true. Docker Compose backendida
# pipeline va bot alohida servis bo'lgani uchun false beriladi.
RUN_BACKGROUND_SERVICES=true

# Rasm topilmaganda Gemini bilan generatsiya (pullik — standart o'chiq)
IMAGE_GENERATION=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Generatsiya qilingan rasmlarning ommaviy manzili (prod'da API domeningiz)
BACKEND_PUBLIC_URL=http://localhost:8000

# Tashqi manzillar (serverga qo'yganda domeningizni yozing)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
# Bir nechta frontend bo'lsa vergul bilan ajrating
CORS_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000

# Email dayjest (ixtiyoriy)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=kuchli-smtp-parol
# SENDER_EMAIL=noreply@example.com
